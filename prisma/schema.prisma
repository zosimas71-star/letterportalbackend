generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  
}

// =====================================================================
// ENUMS  (values are exactly the ones used in api-design.md)
// =====================================================================

enum AccountStatus {
  pending
  active
  suspended
  deactivated
}

/// How the letter was registered. Inbox/outbox lists are filtered by this value
/// together with received_by / received_directory_id (recipient) or
/// created_by / owning_directory_id (sender).
enum LetterType {
  internal_inbox
  internal_outbox
  outside_inbox
  outside_outbox
}

enum LetterCondition {
  initial
  response
}

enum LetterSourceType {
  generated // typed in the system   -> files = []
  uploaded // file(s) sent with the letter
  scanned // scan(s) sent with the letter
}

/// send -> received -> responded -> closed -> archived
enum LetterStatus {
  send
  received
  responded
  closed
  archived
}

enum FileRole {
  original
  attachment
  scan
  generated_pdf
  response
}

enum CaptureMethod {
  upload
  scanner
  camera
  generated
}

/// send -> seen -> closed -> archived
enum ResponseStatus {
  send
  seen
  closed
  archived
}

enum ConversationType {
  direct
  group
  letter
}

enum AnnouncementStatus {
  draft
  published
  archived
}

enum InquiryStatus {
  new
  assigned
  in_progress
  resolved
  closed
}

// =====================================================================
// 1. ORGANIZATIONAL DIRECTORIES
// =====================================================================

model Directory {
  directory_id        Int      @id @default(autoincrement())
  directory_code      String   @unique @db.VarChar(30)
  directory_name      String   @db.VarChar(255)
  description         String?  @db.Text
  parent_directory_id Int?
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now()) @db.Timestamp(0)

  parent   Directory?  @relation("DirectoryHierarchy", fields: [parent_directory_id], references: [directory_id], onDelete: Restrict)
  children Directory[] @relation("DirectoryHierarchy")

  roleAssignments  UserRoleAssignment[]
  ownedLetters     Letter[]             @relation("LetterOwnerDirectory")
  receivedLetters  Letter[]             @relation("LetterReceivedDirectory")
  responses        LetterResponse[]
  templates        LetterTemplate[]
  stamps           Stamp[]

  @@index([parent_directory_id])
  @@index([is_active])
  @@map("directories")
}

// =====================================================================
// 2. USERS AND ACCESS CONTROL
// =====================================================================

model User {
  user_id         Int           @id @default(autoincrement())
  employee_number String?       @unique @db.VarChar(50)
  first_name      String        @db.VarChar(100)
  last_name       String        @db.VarChar(100)
  email           String        @unique @db.VarChar(255)
  phone           String?       @db.VarChar(30)
  password_hash   String        @db.VarChar(255)
  account_status  AccountStatus @default(pending)
  created_at      DateTime      @default(now()) @db.Timestamp(0)
   last_login_at   DateTime?     @db.Timestamp(0)

  roleAssignments  UserRoleAssignment[] @relation("AssignedUser")
  assignmentsMade  UserRoleAssignment[] @relation("AssignmentMadeBy")
  createdLetters   Letter[]             @relation("LetterCreator")
  receivedLetters  Letter[]             @relation("LetterReceiver")
  uploadedFiles    LetterFile[]
  responses        LetterResponse[]
  templatesCreated LetterTemplate[]
  signatures       DigitalSignature[]
  uploadedStamps   Stamp[]              @relation("StampUploader")

  conversationsCreated Conversation[]       @relation("ConversationCreator")
  conversationMembers  ConversationMember[]
  messages             Message[]
  messageAttachments   MessageAttachment[]

  notifications     Notification[]
  auditLogs         AuditLog[]
  announcements     Announcement[]
  faqsCreated       Faq[]
  inquiriesAssigned ContactInquiry[] @relation("InquiryAssignee")

  @@index([account_status])
  @@index([last_name, first_name])
  @@map("users")
}

model Role {
  role_id     Int     @id @default(autoincrement())
  role_name   String  @unique @db.VarChar(100)
  description String? @db.Text

  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  permission_id   Int     @id @default(autoincrement())
  permission_code String  @unique @db.VarChar(100)
  permission_name String  @db.VarChar(150)
  description     String? @db.Text

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_permission_id Int @id @default(autoincrement())
  role_id            Int
  permission_id      Int

  role       Role       @relation(fields: [role_id], references: [role_id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [permission_id], onDelete: Restrict)

  @@unique([role_id, permission_id])
  @@index([permission_id])
  @@map("role_permissions")
}

model UserRoleAssignment {
  assignment_id Int      @id @default(autoincrement())
  user_id       Int
  role_id       Int
  directory_id  Int
  assigned_by   Int?
  assigned_at   DateTime @default(now()) @db.Timestamp(0)
  is_active     Boolean  @default(true)

  user      User      @relation("AssignedUser", fields: [user_id], references: [user_id], onDelete: Restrict)
  role      Role      @relation(fields: [role_id], references: [role_id], onDelete: Restrict)
  directory Directory @relation(fields: [directory_id], references: [directory_id], onDelete: Restrict)
  assigner  User?     @relation("AssignmentMadeBy", fields: [assigned_by], references: [user_id], onDelete: SetNull)

  @@unique([user_id, role_id, directory_id])
  @@index([directory_id, is_active])
  @@index([user_id, is_active])
  @@index([role_id])
  @@map("user_role_assignments")
}

// =====================================================================
// 3. OFFICIAL LETTERS AND FILES
//    A letter is created and sent in ONE step (POST /letters):
//    received_directory_id + received_by say who it is sent to.
//    Files are sent in the same request (multipart); generated letters have no files.
// =====================================================================

model Letter {
  letter_id             Int              @id @default(autoincrement())
  tracking_number       String           @unique @db.VarChar(100) // LTR-<year>-<letter_id padded>, set by the backend in the creating transaction
  subject               String           @db.VarChar(255)
  description           String?          @db.Text
  letter_content        String?          @db.Text
  source_type           LetterSourceType @default(generated)
  letter_type           LetterType
  letter_condition      LetterCondition  @default(initial)
  template_id           Int?
  created_by            Int
  received_by           Int
  owning_directory_id   Int
  received_directory_id Int
  stamp_id              Int?
  signature_id          Int
  status                LetterStatus     @default(send)
  letter_date           DateTime?        @db.Date
  response_due_at       DateTime?        @db.Timestamp(0)
  created_at            DateTime         @default(now()) @db.Timestamp(0)
  updated_at            DateTime         @default(now()) @updatedAt @db.Timestamp(0)
  archived_at           DateTime?        @db.Timestamp(0)

  creator           User             @relation("LetterCreator", fields: [created_by], references: [user_id], onDelete: Restrict)
  receiver          User             @relation("LetterReceiver", fields: [received_by], references: [user_id], onDelete: Restrict)
  owningDirectory   Directory        @relation("LetterOwnerDirectory", fields: [owning_directory_id], references: [directory_id], onDelete: Restrict)
  receivedDirectory Directory        @relation("LetterReceivedDirectory", fields: [received_directory_id], references: [directory_id], onDelete: Restrict)
  stamp             Stamp?           @relation(fields: [stamp_id], references: [stamp_id], onDelete: SetNull)
  signature         DigitalSignature @relation(fields: [signature_id], references: [signature_id], onDelete: Restrict)
  template          LetterTemplate?  @relation(fields: [template_id], references: [template_id], onDelete: SetNull)

  files         LetterFile[]
  responses     LetterResponse[] @relation("ResponseSourceLetter") // responses TO this letter
  responseFor   LetterResponse[] @relation("ResponseAttachedLetter") // this letter IS the formal response
  notifications Notification[]
  conversations Conversation[]

  @@index([owning_directory_id, status])
  @@index([received_directory_id, status])
  @@index([received_by, status])
  @@index([created_by])
  @@index([letter_type, status])
  @@index([letter_condition])
  @@index([status, response_due_at])
  @@index([letter_date])
  @@index([created_at])
  @@index([template_id])
  @@index([stamp_id])
  @@index([signature_id])
  @@map("letters")
}

/// No endpoints of its own: rows are written by POST/PATCH /letters (multipart).
model LetterFile {
  file_id           Int           @id @default(autoincrement())
  letter_id         Int
  uploaded_by       Int
  original_filename String        @db.VarChar(255)
  storage_key       String        @db.VarChar(500)
  mime_type         String?       @db.VarChar(100)
  file_size_bytes   BigInt?
  file_role         FileRole
  capture_method    CaptureMethod @default(upload)
  page_number       Int?
  checksum_sha256   String?       @db.VarChar(64)
  uploaded_at       DateTime      @default(now()) @db.Timestamp(0)

  letter   Letter @relation(fields: [letter_id], references: [letter_id], onDelete: Cascade)
  uploader User   @relation(fields: [uploaded_by], references: [user_id], onDelete: Restrict)

  @@index([letter_id, file_role, page_number])
  @@index([uploaded_by])
  @@map("letter_files")
}

// =====================================================================
// 4. FORMAL LETTER RESPONSES
//    response_letter_id is a second letter with letter_condition = response.
// =====================================================================

model LetterResponse {
  response_id             Int            @id @default(autoincrement())
  letter_id               Int
  response_letter_id      Int
  responded_by            Int
  responding_directory_id Int
  response_status         ResponseStatus @default(send)
  responded_at            DateTime       @default(now()) @db.Timestamp(0)
  created_at              DateTime       @default(now()) @db.Timestamp(0)

  letter              Letter    @relation("ResponseSourceLetter", fields: [letter_id], references: [letter_id], onDelete: Restrict)
  responseLetter      Letter    @relation("ResponseAttachedLetter", fields: [response_letter_id], references: [letter_id], onDelete: Restrict)
  responder           User      @relation(fields: [responded_by], references: [user_id], onDelete: Restrict)
  respondingDirectory Directory @relation(fields: [responding_directory_id], references: [directory_id], onDelete: Restrict)

  @@index([letter_id, response_status])
  @@index([response_letter_id])
  @@index([responded_by])
  @@index([responding_directory_id])
  @@map("letter_responses")
}

// =====================================================================
// 5. TEMPLATES, SIGNATURES AND STAMPS
// =====================================================================

model LetterTemplate {
  template_id          Int      @id @default(autoincrement())
  template_name        String   @db.VarChar(255)
  description          String?  @db.Text
  template_storage_key String?  @db.VarChar(500)
  directory_id         Int?
  created_by           Int
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now()) @db.Timestamp(0)

  creator   User       @relation(fields: [created_by], references: [user_id], onDelete: Restrict)
  directory Directory? @relation(fields: [directory_id], references: [directory_id], onDelete: SetNull)
  letters   Letter[]

  @@index([directory_id, is_active])
  @@index([created_by])
  @@map("letter_templates")
}

/// The signer's reusable signature; a letter points to it with letters.signature_id.
model DigitalSignature {
  signature_id        Int      @id @default(autoincrement())
  signed_by           Int
  signature_type      String   @db.VarChar(50)
  signature_reference String?  @db.VarChar(500)
  signature_image_url String?  @db.VarChar(500)
  signed_at           DateTime @default(now()) @db.Timestamp(0)
  is_active           Boolean  @default(true)

  signer  User     @relation(fields: [signed_by], references: [user_id], onDelete: Restrict)
  letters Letter[]

  @@index([signed_by, is_active])
  @@map("digital_signatures")
}

model Stamp {
  stamp_id        Int      @id @default(autoincrement())
  stamp_name      String   @db.VarChar(150)
  stamp_image_url String   @db.VarChar(500)
  directory_id    Int?
  uploaded_by     Int
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamp(0)

  directory Directory? @relation(fields: [directory_id], references: [directory_id], onDelete: SetNull)
  uploader  User       @relation("StampUploader", fields: [uploaded_by], references: [user_id], onDelete: Restrict)
  letters   Letter[]

  @@index([directory_id, is_active])
  @@index([uploaded_by])
  @@map("stamps")
}

// =====================================================================
// 6. INTERNAL CHAT AND COMMUNICATION
// =====================================================================

model Conversation {
  conversation_id   Int              @id @default(autoincrement())
  conversation_type ConversationType @default(direct)
  letter_id         Int?
  conversation_name String?          @db.VarChar(255)
  created_by        Int
  created_at        DateTime         @default(now()) @db.Timestamp(0)
  is_active         Boolean          @default(true)

  creator  User                 @relation("ConversationCreator", fields: [created_by], references: [user_id], onDelete: Restrict)
  letter   Letter?              @relation(fields: [letter_id], references: [letter_id], onDelete: SetNull)
  members  ConversationMember[]
  messages Message[]

  @@index([letter_id])
  @@index([created_by])
  @@map("conversations")
}

/// Re-joining after leaving: clear left_at on the existing row (unique pair).
model ConversationMember {
  conversation_member_id Int       @id @default(autoincrement())
  conversation_id        Int
  user_id                Int
  joined_at              DateTime  @default(now()) @db.Timestamp(0)
  left_at                DateTime? @db.Timestamp(0)

  conversation Conversation @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [user_id], onDelete: Restrict)

  @@unique([conversation_id, user_id])
  @@index([user_id, left_at])
  @@map("conversation_members")
}

model Message {
  message_id      Int       @id @default(autoincrement())
  conversation_id Int
  sender_id       Int
  message_text    String    @db.Text
  sent_at         DateTime  @default(now()) @db.Timestamp(0)
  edited_at       DateTime? @db.Timestamp(0)
  deleted_at      DateTime? @db.Timestamp(0)

  conversation Conversation        @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade)
  sender       User                @relation(fields: [sender_id], references: [user_id], onDelete: Restrict)
  attachments  MessageAttachment[]

  @@index([conversation_id, sent_at])
  @@index([sender_id])
  @@map("messages")
}

model MessageAttachment {
  attachment_id     Int      @id @default(autoincrement())
  message_id        Int
  uploaded_by       Int
  original_filename String   @db.VarChar(255)
  storage_key       String   @db.VarChar(500)
  mime_type         String?  @db.VarChar(100)
  file_size_bytes   BigInt?
  uploaded_at       DateTime @default(now()) @db.Timestamp(0)

  message  Message @relation(fields: [message_id], references: [message_id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaded_by], references: [user_id], onDelete: Restrict)

  @@index([message_id])
  @@index([uploaded_by])
  @@map("message_attachments")
}

// =====================================================================
// 7. NOTIFICATIONS AND AUDIT LOGS
// =====================================================================

model Notification {
  notification_id   Int       @id @default(autoincrement())
  user_id           Int
  notification_type String    @db.VarChar(50) // e.g. letter_sent, letter_responded
  title             String    @db.VarChar(255)
  message           String?   @db.Text
  related_letter_id Int?
  is_read           Boolean   @default(false)
  created_at        DateTime  @default(now()) @db.Timestamp(0)
  read_at           DateTime? @db.Timestamp(0)

  user   User    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  letter Letter? @relation(fields: [related_letter_id], references: [letter_id], onDelete: SetNull)

  @@index([user_id, is_read, created_at])
  @@index([related_letter_id])
  @@map("notifications")
}

model AuditLog {
  audit_log_id BigInt   @id @default(autoincrement()) @db.BigInt
  user_id      Int?
  action       String   @db.VarChar(100) // e.g. letter.create
  entity_type  String   @db.VarChar(100) // e.g. Letter
  entity_id    String?  @db.VarChar(100)
  details      String?  @db.Text
  ip_address   String?  @db.VarChar(45)
  created_at   DateTime @default(now()) @db.Timestamp(0)

  user User? @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([entity_type, entity_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}

// =====================================================================
// 8. WEBSITE SUPPORT FEATURES
// =====================================================================

model Announcement {
  announcement_id Int                @id @default(autoincrement())
  title           String             @db.VarChar(255)
  content         String             @db.Text
  created_by      Int
  published_at    DateTime?          @db.Timestamp(0)
  expires_at      DateTime?          @db.Timestamp(0)
  status          AnnouncementStatus @default(draft)
  created_at      DateTime           @default(now()) @db.Timestamp(0)

  creator User @relation(fields: [created_by], references: [user_id], onDelete: Restrict)

  @@index([status, published_at])
  @@index([created_by])
  @@map("announcements")
}

model Faq {
  faq_id       Int       @id @default(autoincrement())
  question     String    @db.Text
  answer       String    @db.Text
  category     String?   @db.VarChar(100)
  created_by   Int?
  is_published Boolean   @default(false)
  created_at   DateTime  @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @updatedAt @db.Timestamp(0)

  creator User? @relation(fields: [created_by], references: [user_id], onDelete: SetNull)

  @@index([is_published, category])
  @@map("faqs")
}

model ContactInquiry {
  inquiry_id     Int           @id @default(autoincrement())
  sender_name    String        @db.VarChar(200)
  sender_email   String        @db.VarChar(255)
  subject        String        @db.VarChar(255)
  message        String        @db.Text
  inquiry_status InquiryStatus @default(new)
  assigned_to    Int?
  submitted_at   DateTime      @default(now()) @db.Timestamp(0)
  resolved_at    DateTime?     @db.Timestamp(0)

  assignee User? @relation("InquiryAssignee", fields: [assigned_to], references: [user_id], onDelete: SetNull)

  @@index([inquiry_status, submitted_at])
  @@index([assigned_to])
  @@map("contact_inquiries")
}