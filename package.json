{
  "name": "letter-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Official Letter Management API - COMMON, AUTH and USR modules (plain JavaScript, ES modules)",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev fourmigration",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "format": "prettier --write \"{src,prisma,test}/**/*.js\""
  },
  "prisma": { "seed": "node prisma/seed.js" },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prettier": "^3.3.0",
    "prisma": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
